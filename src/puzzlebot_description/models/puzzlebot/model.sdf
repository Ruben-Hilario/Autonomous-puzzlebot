<?xml version='1.0'?>
<sdf version='1.4'>
    <model name='puzzlebot' canonical_link='chassis'>

        <link name='chassis'>
            <pose relative_to='__model__'>0 0 0.05 1.5708 0 1.5708</pose>
            
            <inertial>
                <mass>0.8</mass>
                <pose>-0.05 0 0 0 0 0</pose>
                <inertia>
                    <ixx>0.004</ixx>
                    <iyy>0.004</iyy>
                    <izz>0.004</izz>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>
            
            <visual name='visual'>
                <geometry>
                    <mesh>
                        <uri>./meshes/chassis.stl</uri>
                        <!-- <scale> 0.15 0.15 0.15 </scale>
                        <uri>../wheelchair/meshes/base_link.stl</uri> -->
                    </mesh>
                </geometry>
            </visual>
            
            <collision name='collision'>
                <pose>0 0 0 0 1.5708 1.5708</pose>
                <geometry>
                    <box>
                        <size>0.2 0.16 0.046</size>
                    </box>
                </geometry>
            </collision>
            
            <sensor type="camera" name="camera">
                <pose relative_to='camera_frame'>0 0 0 0 -1.5708 -1.5708</pose>
                <camera>
                    <horizontal_fov>1.047</horizontal_fov>
                    <image>
                        <width>1280</width>
                        <height>720</height>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>100</far>
                    </clip>
                </camera>
                <always_on>1</always_on>
                <update_rate>30</update_rate>
                <visualize>false</visualize>
            </sensor>
            <sensor name="rplidar" type="gpu_lidar">
                <pose relative_to='rplidar_frame'>0 0 0 0 0 0</pose>
                <update_rate>10</update_rate>
                <ray>
                    <scan>
                    <horizontal>
                        <samples>720</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14</min_angle>
                        <max_angle>3.14</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </vertical>
                    </scan>
                    <range>
                    <min>0.1</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                    </range>
                </ray>
                <always_on>1</always_on>
                <visualize>true</visualize>
            </sensor> 
        </link>
        <link name="lidar_link">
            <pose relative_to="chassis">0 0.09 0.04 3.141592 -1.57 1.57</pose>
            <inertial>
                <mass>0.1</mass>
                <inertia>
                <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
                <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
                </inertia>
            </inertial>

            <!-- Visual mesh -->
            <visual name="lidar_visual">
                <geometry>
                <mesh>
                    <uri>./meshes/LiDAR.stl</uri>
                    <scale>0.001 0.001 0.001</scale>
                </mesh>
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 1.0"/>
                </material>
            </visual>

            <!-- Optional-->
            <collision name="lidar_collision">
                <geometry>
                <mesh>
                    <uri>./meshes/LiDAR.stl</uri>
                    <scale>0.001 0.001 0.001</scale>
                </mesh>
                <!-- <cylinder>
                    <radius>0.03</radius>
                    <length>0.05</length>
                </cylinder> -->
                </geometry>
            </collision>
        </link>
        <link name='right_wheel'>
            <pose relative_to="chassis">-0.09 0 0.05 0 1.5708 0</pose>
            
            <inertial>
                <mass>0.05</mass>
                <inertia>
                    <ixx>0.002</ixx>
                    <iyy>0.002</iyy>
                    <izz>0.002</izz>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>
            
            <visual name='visual'>
                <geometry>
                    <mesh>
                        <uri>./meshes/wheel.stl</uri>
                        <!-- <scale>0.15 0.15 0.15</scale>
                        <uri>../wheelchair/meshes/right_wheel_link.stl</uri> -->
                    </mesh>
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 1.0"/>
                </material>
            </visual>
            
            <collision name='collision'>
                <pose>0 -0.0025 0 0 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.05</radius>
                        <length>0.005</length>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>1.0</mu>
                            <mu2>1.0</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            
        </link>

        <link name='left_wheel'>
            <pose relative_to="chassis">0.09 0 0.05 -1.5708 0 1.5708</pose>
            
            <inertial>
                <mass>0.05</mass>
                <inertia>
                    <ixx>0.002</ixx>
                    <iyy>0.002</iyy>
                    <izz>0.002</izz>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>
            
            <visual name='visual'>
                <geometry>
                    <mesh>
                        <uri>./meshes/wheel.stl</uri>
                        <!-- <scale>0.15 0.15 0.15</scale>
                        <uri>../wheelchair/meshes/left_wheel_link.stl</uri> -->
                    </mesh>
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 1.0"/>
                </material>
            </visual>
            
            <collision name='collision'>
                <pose>0 -0.0025 0 0 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.05</radius>
                        <length>0.005</length>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>1.0</mu>
                            <mu2>1.0</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            
        </link>

        <frame name="caster_frame" attached_to='chassis'>
            <pose>0 -0.044 -0.095 0 0 0</pose>
        </frame>

        <link name='caster'>
            <pose relative_to='caster_frame'/>
            
            <inertial>
                <mass>0.01</mass>
                <inertia>
                    <ixx>0.0000025</ixx>
                    <iyy>0.0000025</iyy>
                    <izz>0.0000025</izz>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>
            
            <visual name='visual'>
                <geometry>
                    <sphere>
                        <radius>0.006</radius>
                    </sphere>
                </geometry>
                <material>
                    <ambient>0.0 1 0.0 1</ambient>
                    <diffuse>0.0 1 0.0 1</diffuse>
                    <specular>0.0 1 0.0 1</specular>
                </material>
            </visual>
            
            <collision name='collision'>
                <geometry>
                    <sphere>
                        <radius>0.006</radius>
                    </sphere>
                </geometry>
            </collision>
        </link>

        <joint name='left_wheel_joint' type='revolute'>
            <pose relative_to='left_wheel'/>
            <parent>chassis</parent>
            <child>left_wheel</child>
            <axis>
                <xyz expressed_in='__model__'>0 1 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower> 
                    <upper>1.79769e+308</upper>
                    <effort>1</effort>
                </limit>
               <dynamics>
                   <friction>0.1</friction>
               </dynamics>
            </axis>
        </joint>

        <joint name='right_wheel_joint' type='revolute'>
            <pose relative_to='right_wheel'/>
            <parent>chassis</parent>
            <child>right_wheel</child>
            <axis>
                <xyz expressed_in='__model__'>0 1 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower> 
                    <upper>1.79769e+308</upper>
                    <effort>1</effort>
                </limit>
               <dynamics>
                   <friction>0.1</friction>
               </dynamics>
            </axis>
        </joint>

        <joint name='caster_wheel' type='ball'>
            <parent>chassis</parent>
            <child>caster</child>
        </joint>
        <joint name="lidar_joint" type="fixed">
            <parent>chassis</parent>
            <child>lidar_link</child>
        </joint>

        <!-- Puzzlebot differential drive plugin -->
        <plugin name="DiffDynamicPlugin" filename="libDiffDynamicPlugin.so">
            <leftJoint>left_wheel_joint</leftJoint>
            <rightJoint>right_wheel_joint</rightJoint>
            <cmd_R_topic>VelocitySetR</cmd_R_topic>
            <cmd_L_topic>VelocitySetL</cmd_L_topic>
            <cmd_vel_topic>cmd_vel</cmd_vel_topic>
            <enc_R_topic>VelocityEncR</enc_R_topic>
            <enc_L_topic>VelocityEncL</enc_L_topic>
            <robot_vel_topic>robot_vel</robot_vel_topic>
            <mot_Vmax>5</mot_Vmax>
            <mot_J>0.0005</mot_J>
            <mot_R>2</mot_R>
            <mot_L>0.01</mot_L>
            <mot_K>0.01</mot_K>
            <mot_b>0.00001</mot_b>
            <mot_gear>34</mot_gear>
            <robot_width>0.18</robot_width>
            <wheel_radius>0.05</wheel_radius>
            <pid_Kp>0.1</pid_Kp>
            <pid_Ti>0.05</pid_Ti>
            <pid_Td>0</pid_Td>
            <input_type>1</input_type>
            <rate>100</rate>
        </plugin>
        <!-- Uncomment if using for ball interactions -->
        <frame name="camera_frame" attached_to='chassis'>
            <pose>0 0.1 0.08 0 0 0</pose>
        </frame>

        <plugin
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
        <!--For navigation-->
        <frame name="rplidar_frame" attached_to='chassis'>
            <pose>0 0.11 0.05 1.5708 1.5708 0</pose>
            <!-- <pose>0 0.11 0.05 0 0 0</pose> -->
        </frame>
    </model>

</sdf>

